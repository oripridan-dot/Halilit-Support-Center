# Halilit Support Center - Root .gitignore

# === LARGE ASSETS (Download/Generate at runtime) ===
# These are NOT tracked in git - too large
# Use CDN or download scripts to populate

# Product images (452MB+)
frontend/public/data/product_images/
frontend/public/data/thumbnails/

# Manuals (340MB+)
frontend/public/assets/manuals/

# Brand images (237MB+)
frontend/public/assets/images/

# Media files
frontend/public/assets/media/

# === DEPENDENCIES ===
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# === BUILD OUTPUTS ===
dist/
dist-ssr/
*.local
build/

# === IDE ===
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# === LOGS ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === TEST OUTPUTS ===
test-results/
coverage/

# === ENVIRONMENT ===
.env.local
.env.*.local

# === BACKEND DATA (regenerated by pipeline) ===
backend/data/1_official/
backend/data/2_commercial/
backend/data/3_contextual/
backend/data/4_validated/
backend/data/5_golden/
backend/data/reports/
.env

# === GENERATED INGESTION DATA ===
backend/data/ingestion/products/
backend/data/ingestion/reports/
backend/logs/
