# Halilit Support Center v9.0 — Root .gitignore

# === DEPENDENCIES ===
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# === BUILD OUTPUTS ===
dist/
dist-ssr/
*.local
build/

# === IDE ===
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# === LOGS ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === TEST OUTPUTS ===
test-results/
coverage/

# === ENVIRONMENT & SECRETS ===
.env
.env.local
.env.*.local
*.env.bak

# === GENERATED FRONTEND DATA ===
# Product JSONs are generated by skeleton-sync and JIT agent.
frontend/public/data/*.json
frontend/public/data/shards/
frontend/public/data/categories/
frontend/public/data/product_images/
frontend/public/data/thumbnails/

# === GENERATED BACKEND DATA ===
# Runtime data — regenerated by skeleton sync, scraper, and JIT agent.
backend/data/ingestion/
backend/data/brands/
backend/data/graph/
backend/data/jit_cache/
backend/data/1_official/
backend/data/2_commercial/
backend/data/3_contextual/
backend/data/4_validated/
backend/data/5_golden/
backend/data/reports/
backend/data/*.json
backend/data/*.txt
backend/data/*.html
backend/logs/

# === FRONTEND ASSETS (generated/downloadable) ===
frontend/public/assets/manuals/
frontend/public/assets/images/
frontend/public/assets/media/
generation_results.json

# === LOCK FILES (CI uses pnpm) ===
/pnpm-lock.yaml
frontend/package-lock.json

# === ROOT-LEVEL GENERATED ===
.agent_memory/
