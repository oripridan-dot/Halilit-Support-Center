# Halilit Support Center - Root .gitignore

# === DEPENDENCIES ===
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# === BUILD OUTPUTS ===
dist/
dist-ssr/
*.local
build/

# === IDE ===
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# === LOGS ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === TEST OUTPUTS ===
test-results/
coverage/

# === ENVIRONMENT ===
.env
.env.local
.env.*.local

# === GENERATED FRONTEND DATA ===
# All brand/product JSON files are generated by the backend pipeline.
# Only category_thumbnails (static assets) and .gitkeep are tracked.
frontend/public/data/*.json
frontend/public/data/shards/
frontend/public/data/categories/
frontend/public/data/product_images/
frontend/public/data/thumbnails/

# === GENERATED BACKEND DATA ===
# All pipeline outputs — regenerated by Trinity Swarm agents.
backend/data/ingestion/
backend/data/brands/
backend/data/1_official/
backend/data/2_commercial/
backend/data/3_contextual/
backend/data/4_validated/
backend/data/5_golden/
backend/data/reports/
backend/logs/

# === FRONTEND ASSETS (generated/downloadable) ===
frontend/public/assets/manuals/
frontend/public/assets/images/
frontend/public/assets/media/
generation_results.json
pnpm-lock.yaml
