import React, { useState, useEffect, useMemo, useCallback } from 'react';
import {
  ArrowLeft,
  ChevronDown,
  ChevronRight,
  Loader2,
  AlertTriangle,
  X,
} from 'lucide-react';
import { useLocation, useNavigate } from 'react-router-dom';

import { AsyncResult, createAsyncResult, EventHandler, FilterOptions, PaginationInfo } from '../../types/componentUtils';
import { useProductSearch } from '../../hooks/useProductSearch';
import { Product } from '../../types';
import { useDebouncedValue } from '../../hooks/useDebouncedValue';
import { useNavigationStore } from '../../store/navigationStore';
import { createSchema } from '../../lib/zod';
import { useInventorySearch } from '../../hooks/useInventorySearch';
import { useQueryParams } from '../../hooks/useQueryParams';


const EnhancedInventorySearchDebounceWithThrottleSchema = createSchema(
    {
        search: { type: 'string', required: false, nullable: true },
        page: { type: 'number', required: false, nullable: false, default: 1 },
        pageSize: { type: 'number', required: false, nullable: false, default: 10 },
    }
);

interface InventoryViewProps {
  /**
   * Brand color for the component.
   * @default "#3b82f6"
   */
  brandColor?: string;
}

const InventoryView: React.FC<InventoryViewProps> = ({ brandColor = '#3b82f6' }) => {
  const navigate = useNavigate();
  const location = useLocation();

  const {
    queryParams,
    setQueryParams,
    resetQueryParams,
  } = useQueryParams(EnhancedInventorySearchDebounceWithThrottleSchema);

  const [search, setSearch] = useState(queryParams.search || '');
  const debouncedSearch = useDebouncedValue(search, 300);

  const [page, setPage] = useState(queryParams.page || 1);
  const [pageSize, setPageSize] = useState(queryParams.pageSize || 10);

  const { data, isLoading, error, refetch, pagination } = useInventorySearch({
    search: debouncedSearch,
    page,
    pageSize,
  });


  useEffect(() => {
    setQueryParams({
      search,
      page,
      pageSize,
    });
  }, [search, page, pageSize, setQueryParams]);


  const handleSearchChange: EventHandler<React.ChangeEvent<HTMLInputElement>> = (e) => {
    setSearch(e.target.value);
    setPage(1);
  };

  const handlePageChange = useCallback((newPage: number) => {
    setPage(newPage);
  }, [setPage]);

  const handlePageSizeChange = useCallback((newPageSize: number) => {
    setPageSize(newPageSize);
    setPage(1);
  }, [setPageSize, setPage]);

  const goToProduct = useCallback((productId: string) => {
    navigate(`/product/${productId}`);
  }, [navigate]);

  const clearSearch = () => {
    setSearch('');
  };


  if (error) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-center">
          <AlertTriangle size={48} className="text-red-500 mx-auto mb-4" />
          <p className="text-zinc-400">An error occurred while fetching inventory.</p>
          <button onClick={refetch} className="mt-4 px-4 py-2 bg-zinc-700 hover:bg-zinc-600 rounded-md text-white">
            Retry
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-full">
      {/* Header */}
      <div
        className="flex items-center justify-between p-4 border-b border-zinc-800/50"
        style={{ background: `${brandColor}05` }}
      >
        <button
          onClick={() => navigate(-1)}
          className="p-2 rounded-md hover:bg-zinc-800 transition-colors"
        >
          <ArrowLeft size={20} className="text-zinc-400" />
        </button>
        <h1 className="text-lg font-semibold text-white">Inventory</h1>
        <div></div>
      </div>

      {/* Search Bar */}
      <div className="p-4 space-y-4">
        <div className="relative">
          <input
            type="text"
            placeholder="Search products..."
            value={search}
            onChange={handleSearchChange}
            className="w-full px-4 py-2 pl-10 rounded-lg bg-zinc-800/50 border border-zinc-700 text-zinc-200 focus:outline-none focus:border-blue-500 transition-colors placeholder-zinc-500"
          />
          {search && (
            <button
              onClick={clearSearch}
              className="absolute top-2 right-2 p-2 rounded-md hover:bg-zinc-700 transition-colors"
            >
              <X size={16} className="text-zinc-400" />
            </button>
          )}
        </div>
      </div>

      {/* Content */}
      <div className="flex-1 overflow-y-auto">
        {isLoading && (
          <div className="flex items-center justify-center h-full">
            <Loader2 size={32} className="animate-spin text-zinc-400" />
          </div>
        )}

        {(!isLoading && data?.length === 0) && (
          <div className="flex items-center justify-center h-full text-zinc-400">
            No products found.
          </div>
        )}

        {!isLoading && data && data.length > 0 && (
          <div className="space-y-4 p-4">
            {data.map((product) => (
              <div
                key={product.id}
                className="p-4 rounded-lg bg-zinc-800/50 border border-zinc-700 hover:border-zinc-600 transition-colors cursor-pointer"
                onClick={() => goToProduct(product.id)}
              >
                <h3 className="text-lg font-medium text-zinc-100">{product.name}</h3>
                <p className="text-zinc-400">
                  ID: {product.id}
                </p>
                <p className="text-zinc-400">
                  Stock: {product.stock !== null && product.stock !== undefined ? product.stock : 'Unknown'}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Pagination */}
      {(pagination?.total || 0) > 0 && (
        <div className="flex items-center justify-between p-4 border-t border-zinc-800/50">
          <div className="flex items-center gap-2">
            <span className="text-sm text-zinc-400">
              Page {pagination?.page} of {Math.ceil((pagination?.total || 0) / pageSize)}
            </span>
          </div>

          <div className="flex items-center gap-2">
            <select
              value={pageSize}
              onChange={(e) => handlePageSizeChange(Number(e.target.value))}
              className="px-3 py-2 rounded-md bg-zinc-800/50 border border-zinc-700 text-zinc-200 focus:outline-none focus:border-blue-500 transition-colors"
            >
              {[10, 25, 50, 100].map((size) => (
                <option key={size} value={size}>
                  Show {size}
                </option>
              ))}
            </select>
            <button
              onClick={() => handlePageChange(Math.max(1, (pagination?.page || 1) - 1))}
              disabled={(pagination?.page || 1) <= 1}
              className={`px-3 py-2 rounded-md  transition-colors ${(pagination?.page || 1) <= 1 ? 'bg-zinc-700/50 text-zinc-500' : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-200'}`}
            >
              <ChevronLeft size={20} />
            </button>
            <button
              onClick={() => handlePageChange((pagination?.page || 1) + 1)}
              disabled={((pagination?.page || 1) * pageSize) >= (pagination?.total || 0)}
              className={`px-3 py-2 rounded-md  transition-colors ${( (pagination?.page || 1) * pageSize) >= (pagination?.total || 0) ? 'bg-zinc-700/50 text-zinc-500' : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-200'}`}
            >
              <ChevronRight size={20} />
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default InventoryView;