import React, { useState, useMemo, useCallback } from "react";
import {
  ArrowLeft,
  Copy,
  Check,
  ExternalLink,
  FileText,
  Package,
  Loader2,
  AlertTriangle,
  Zap,
  BookOpen,
  Clock,
  ChevronRight,
  Lock,
} from "lucide-react";
import {
  useConductorCatalog,
  useProductRelationships,
} from "../../hooks/useConductorCatalog";
import { useJITIntelligence } from "../../hooks/useJITIntelligence";
import { useNavigationStore } from "../../store/navigationStore";
import { BaseComponentProps } from "../../types/componentUtils";

// ── Helpers ────────────────────────────────────────────────────────────────────

function fmtPrice(n: number | null | undefined): string {
  if (n == null || n === 0) return "—";
  return `₪${n.toLocaleString()}`;
}

function isCfp(price: number | null | undefined): boolean {
  return price == null || price === 0;
}

// ── StockDot ───────────────────────────────────────────────────────────────────
interface StockDotProps {
  stock?: number | null;
}
const StockDot: React.FC<StockDotProps> = ({ stock }) => {
  if (stock === 0)
    return (
      <>
        <span className="w-2 h-2 rounded-full bg-red-500 inline-block" />{" "}
        <span className="text-red-400 text-sm">Out of Stock</span>
      </>
    );
  if (stock == null)
    return (
      <>
        <span className="w-2 h-2 rounded-full bg-zinc-600 inline-block" />{" "}
        <span className="text-zinc-500 text-sm">Unknown</span>
      </>
    );
  return (
    <>
      <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block" />{" "}
      <span className="text-emerald-400 text-sm">In Stock</span>
    </>
  );
};

// ── Toast ──────────────────────────────────────────────────────────────────────
interface ToastProps {
  msg: string;
}
const Toast: React.FC<ToastProps> = ({ msg }) => (
  <div
    className="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-4 py-2.5 rounded-xl
    bg-zinc-900 border border-zinc-700 text-sm text-zinc-200 shadow-xl animate-fade-in"
  >
    <Check size={13} className="text-emerald-400" />
    {msg}
  </div>
);

// ── Skeleton ───────────────────────────────────────────────────────────────────
interface SkeletonPulseProps {
  className?: string;
}
const SkeletonPulse: React.FC<SkeletonPulseProps> = ({ className = "" }) => (
  <div className={`bg-zinc-900 rounded animate-pulse ${className}`} />
);

// Pure loading skeleton — NO mock data, only animated placeholder shapes.
const SkeletonHeader = () => (
  <div
    role="status"
    aria-label="Loading product data…"
    className="p-6 flex gap-6"
  >
    <SkeletonPulse className="w-48 h-40 rounded-xl shrink-0" />
    <div className="flex-1 space-y-3 pt-1">
      <SkeletonPulse className="h-6 w-64" />
      <SkeletonPulse className="h-4 w-24" />
      <SkeletonPulse className="h-3 w-20" />
    </div>
    <div className="w-40 space-y-2 pt-1">
      <SkeletonPulse className="h-8 w-full" />
      <SkeletonPulse className="h-4 w-24" />
      <SkeletonPulse className="h-4 w-16" />
    </div>
    <span className="sr-only">Loading produ</span>
  </div>
);

interface ProductDetailViewProps extends BaseComponentProps {
  productId: string;
}

const ProductDetailView: React.FC<ProductDetailViewProps> = ({
  productId,
  className,
}) => {
  const { push } = useNavigationStore();
  const { product, isLoading, error } = useConductorCatalog(productId);
  const {
    jitIntelligence,
    isLoading: isJitLoading,
    error: jitError,
  } = useJITIntelligence(productId);
  const { relationships, isLoading: isRelationshipsLoading } =
    useProductRelationships(productId);
  const [isCopied, setIsCopied] = useState(false);

  const handleCopyClick = useCallback(async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      setIsCopied(true);
      setTimeout(() => setIsCopied(false), 2000);
    } catch (err) {
      console.error("Failed to copy: ", err);
    }
  }, []);

  const handleBackClick = useCallback(() => {
    push(-1);
  }, [push]);

  if (isLoading) {
    return (
      <div className="p-4">
        <SkeletonHeader />
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-4 text-center">
        <AlertTriangle size={48} className="mx-auto text-red-500" />
        <p className="mt-4 text-red-400">Failed to load product details.</p>
        <p className="text-zinc-500 text-sm">
          Please try again later or contact support.
        </p>
      </div>
    );
  }

  if (!product) {
    return (
      <div className="p-4 text-center">
        <AlertTriangle size={48} className="mx-auto text-red-500" />
        <p className="mt-4 text-red-400">Product not found.</p>
        <p className="text-zinc-500 text-sm">
          The product you requested could not be found.
        </p>
      </div>
    );
  }

  const {
    name,
    image_url,
    description,
    price,
    stock,
    specs,
    brand,
    external_url,
  } = product;

  return (
    <div className={`p-4 ${className}`}>
      {isCopied && <Toast msg="Copied to clipboard!" />}

      <div className="flex items-center gap-4 mb-4">
        <button
          onClick={handleBackClick}
          className="p-2 rounded-full hover:bg-zinc-800 transition-colors"
        >
          <ArrowLeft size={20} />
        </button>
        <h1 className="text-2xl font-bold">{name}</h1>
        <button
          onClick={handleCopyClick}
          className="ml-auto p-2 rounded-full hover:bg-zinc-800 transition-colors"
          aria-label="Copy product URL to clipboard"
        >
          <Copy size={20} />
        </button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Image & Price */}
        <div>
          <img
            src={image_url || "/placeholder.png"}
            alt={name}
            className="w-full rounded-xl shadow-md mb-4"
            onError={(e) => {
              (e.target as HTMLImageElement).src = "/placeholder.png";
            }}
          />

          <div className="flex items-center justify-between mb-2">
            <div>
              <p className="text-2xl font-bold">
                {isCfp(price) ? "Call for Price" : fmtPrice(price)}
              </p>
              <p className="text-sm text-zinc-500">
                {brand?.name || "Unknown Brand"}
              </p>
            </div>
            <StockDot stock={stock} />
          </div>

          {external_url && (
            <a
              href={external_url}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-800/50 hover:bg-zinc-700 transition-colors"
              aria-label="View product on external website"
            >
              <ExternalLink size={16} />
              View on {brand?.name || "External Site"}
            </a>
          )}
        </div>

        {/* Details */}
        <div>
          <div className="prose prose-invert max-w-none mb-4">
            {description}
          </div>

          {/* Relationships */}
          {relationships?.length && (
            <div className="mb-4">
              <h3 className="text-lg font-semibold mb-2">Related Products</h3>
              <div className="space-y-2">
                {relationships.map((rel, index) => (
                  <div
                    key={index}
                    className="flex items-center justify-between p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <p className="text-sm">{rel.product.name}</p>
                    <ChevronRight size={16} className="text-zinc-400" />
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* JIT Intelligence */}
          {isJitLoading && (
            <div className="flex items-center gap-2">
              <Loader2 size={20} className="animate-spin" />
              <p className="text-sm text-zinc-500">Analyzing product data…</p>
            </div>
          )}
          {jitError && (
            <div className="flex items-center gap-2 text-red-400">
              <AlertTriangle size={20} />
              <p className="text-sm">
                Failed to retrieve JIT intelligence.
              </p>
            </div>
          )}
          {jitIntelligence && (
            <div className="mb-4">
              <h3 className="text-lg font-semibold mb-2">
                JIT Intelligence
              </h3>
              <div className="space-y-2">
                {jitIntelligence.features?.map((feature, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-2 p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <BookOpen size={16} className="text-zinc-400" />
                    <p className="text-sm">{feature.label}</p>
                  </div>
                ))}
                {jitIntelligence.risks?.map((risk, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-2 p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <AlertTriangle size={16} className="text-orange-400" />
                    <p className="text-sm">{risk.label}</p>
                  </div>
                ))}
                {jitIntelligence.opportunities?.map((opp, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-2 p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <Zap size={16} className="text-emerald-400" />
                    <p className="text-sm">{opp.label}</p>
                  </div>
                ))}
                {jitIntelligence.alerts?.map((alert, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-2 p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <Clock size={16} className="text-amber-400" />
                    <p className="text-sm">{alert.label}</p>
                  </div>
                ))}
                {jitIntelligence.compliance?.map((comp, index) => (
                  <div
                    key={index}
                    className="flex items-center gap-2 p-3 rounded-lg bg-zinc-800/30 border border-zinc-800/30 hover:border-zinc-700/50 transition-colors"
                  >
                    <Lock size={16} className="text-zinc-400" />
                    <p className="text-sm">{comp.label}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default ProductDetailView;