interface ProductDetailViewProps {}

const ProductDetailView: React.FC<ProductDetailViewProps> = () => {
  const { products } = useConductorCatalog();
  const { activeProductId } = useNavigationStore();
  const { relationships, isLoading: isRelationshipsLoading } =
    useProductRelationships(activeProductId || "");
  const { jitIntelligence, isLoading: isJITLoading } =
    useJITIntelligence(activeProductId || "");

  const product = useMemo(
    () => products.find((p) => p.id === activeProductId) ?? null,
    [products, activeProductId],
  );

  const [isSpecsDrawerOpen, setIsSpecsDrawerOpen] = useState(false);

  if (!activeProductId || !product) {
