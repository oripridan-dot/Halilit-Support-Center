    brand,
    price,
    price_eilat,
    image_url,
    image_gallery,
    id: sku,
    halilit_url,
    specs,
    description,
    description_short,
    features,
    pros,
    cons,
    rating,
    data_status,
    quality_score,
    data_trust,
    stock,
  } = product;

  const handleOpenSpecsDrawer = () => {
    setIsSpecsDrawerOpen(true);
  };

  const handleCloseSpecsDrawer = () => {
    setIsSpecsDrawerOpen(false);
  };

  const isCallForPriceProduct = isCallForPrice(price);

  return (
    <div className="p-6">
      <div className="flex items-center gap-4 mb-4">
        <button
          onClick={() => window.history.back()}
          className="flex items-center gap-2 text-zinc-400 hover:text-zinc-300 transition-colors"
        >
          <ArrowLeft size={18} /> Back
        </button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Left Column - Product Information */}
        <div>
          {/* Hero Image */}
          <div className="mb-4">
            <ProductImageCarousel
              imageUrls={image_gallery || []}
              mainImageUrl={image_url}
              productName={name}
            />
          </div>

          {/* Product Details */}
          <div>
            <h1 className="text-2xl font-bold text-zinc-100 mb-2">{name}</h1>
            <p className="text-zinc-400 text-sm">{brand}</p>

            <div className="flex items-center gap-4 mt-2">
              <StockDot stock={stock} />
              {isCallForPriceProduct ? (
                <span className="text-red-400 font-bold">Call for Price</span>
              ) : (
                <span className="text-zinc-100 font-bold">
                  {formatShekel(price)}
                </span>
              )}
            </div>

            {/*  Eilat Price  */}
            {price_eilat !== null && price_eilat !== undefined && (
              <div className="mt-1 text-zinc-400 text-sm">
                Eilat Price: {formatShekel(price_eilat)}
              </div>
            )}
            {/* Short Description */}
            {description_short && (
              <p className="text-zinc-300 mt-4 text-sm">{description_short}</p>
            )}

            {/* Description */}
            {description && (
              <div className="mt-4">
                <h3 className="text-zinc-200 font-medium mb-2">Description</h3>
                <p className="text-zinc-300 text-sm">{description}</p>
              </div>
            )}

            {/* Features */}
            {features && features.length > 0 && (
              <div className="mt-4">
                <h3 className="text-zinc-200 font-medium mb-2">Features</h3>
                <ul className="list-disc list-inside text-zinc-300 text-sm">
                  {features.map((feature, index) => (
                    <li key={index}>{feature}</li>
                  ))}
                </ul>
              </div>
            )}

            {/* Pros */}
            {pros && pros.length > 0 && (
              <div className="mt-4">
                <h3 className="text-zinc-200 font-medium mb-2">Pros</h3>
                <ul className="list-disc list-inside text-zinc-300 text-sm">
                  {pros.map((pro, index) => (
                    <li key={index}>{pro}</li>
                  ))}
                </ul>
              </div>
            )}

            {/* Cons */}
            {cons && cons.length > 0 && (
              <div className="mt-4">
                <h3 className="text-zinc-200 font-medium mb-2">Cons</h3>
                <ul className="list-disc list-inside text-zinc-300 text-sm">
                  {cons.map((con, index) => (
                    <li key={index}>{con}</li>
                  ))}
                </ul>
              </div>
            )}

            {/*  Halilit URL  */}
            {halilit_url && (
              <div className="mt-4">
                <a
                  href={halilit_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="flex items-center gap-2 text-blue-400 hover:text-blue-300 transition-colors"
                >
                  <ExternalLink size={16} />
                  Halilit URL
                </a>
              </div>
            )}

            {/* SKU */}
            <div className="mt-4">
              <span className="text-zinc-400 text-sm">SKU: {sku}</span>
            </div>
            {/* Data Quality */}
            <div className="mt-4">
              <span className="text-zinc-400 text-sm">
                Data Status: {data_status}
              </span>
              <span className="text-zinc-400 text-sm ml-2">
                Quality Score: {quality_score?.toFixed(2) || "N/A"}
              </span>
            </div>
            {/* Source Badges */}
            <div className="mt-4 flex gap-2">
              {data_trust?.price_source && (
                <span className="bg-emerald-500/10 text-emerald-400 text-xs font-semibold px-2.5 py-0.5 rounded dark:bg-emerald-700 dark:text-emerald-300">
                  Price: {data_trust.price_source}
                </span>
              )}
              {data_trust?.specs_source && (
                <span className="bg-sky-500/10 text-sky-400 text-xs font-semibold px-2.5 py-0.5 rounded dark:bg-sky-700 dark:text-sky-300">
                  Specs: {data_trust.specs_source}
                </span>
              )}
            </div>
          </div>
        </div>

        {/* Right Column - Additional Information */}
        <div>
          {/* Trusted Consensus */}
          {/* {product && product.reviews && (
            <TrustedConsensus reviews={product.reviews} />
          )} */}

          {/* Related Products */}
          {relationships && relationships.length > 0 && (
            <div className="mt-8">
              <h3 className="text-zinc-200 text-lg font-medium mb-4">
                Related Products
              </h3>
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {relationships.map((relatedProduct) => (
                  <ProductTile key={relatedProduct.id} product={relatedProduct} />
                ))}
              </div>
            </div>
          )}

          {/* JIT Intelligence (Placeholder) */}
          {/* <div className="mt-8">
            <h3 className="text-zinc-200 text-lg font-medium mb-4">
              JIT Intelligence
            </h3>
            {isJITLoading ? (
              <SkeletonPulse className="w-full h-12" />
            ) : (
              <div className="text-zinc-400">
                {jitIntelligence?.summary || "No JIT data available."}
              </div>
            )}
          </div> */}

          {/* Specs Button */}
          {specs && Object.keys(specs).length > 0 && (
            <button
              onClick={handleOpenSpecsDrawer}
              className="mt-8 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 font-medium py-3 px-5 rounded-lg transition-colors w-full"
            >
              View Full Specifications
            </button>
          )}
        </div>
      </div>

      {/* Specs Drawer */}
      {isSpecsDrawerOpen && (
        <SpecsDrawer
          specs={specs || {}}
          productName={name}
          onClose={handleCloseSpecsDrawer}
        />
      )}
    </div>
  );
};

export default ProductDetailView;