// frontend/src/components/views/ProductDetailView.tsx
import React, { useState, useEffect } from 'react';
import { useParams } from 'react-router-dom';
import { Clock } from 'lucide-react';

const ProductDetailView: React.FC = () => {
  const { productId } = useParams<{ productId: string }>();
  const [product, setProduct] = useState<Product | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [sourcingStatus, setSourcingStatus] = useState<SourcingStatus | null>(null);

  useEffect(() => {
    const fetchProductDetails = async () => {
      if (!productId) return;

      setLoading(true);
      setError(null);

      try {
        const productData = await getProduct(productId);
        setProduct(productData);

        const sourcingData = await getProductSourcing(productId);
        setSourcingStatus(sourcingData?.status || 'Unknown Sourcing');

      } catch (err: any) {
        setError(err.message || 'Failed to fetch product details.');
      } finally {
        setLoading(false);
      }
    };

    fetchProductDetails();
  }, [productId]);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-screen dark:bg-zinc-900">
        <Clock className="animate-spin h-10 w-10 text-zinc-400" />
      </div>
    );
  }

  if (error) {
    return (
      <div className="dark:bg-zinc-900 dark:text-zinc-100 p-4">
        Error: {error}
      </div>
    );
  }

  if (!product) {
    return (
      <div className="dark:bg-zinc-900 dark:text-zinc-100 p-4">
        Product not found.
      </div>
    );
  }

  return (
    <div className="dark:bg-zinc-900 dark:text-zinc-100 p-4">
      <h1 className="text-2xl font-bold mb-4">{product.name}</h1>
      <div className="flex items-center space-x-2 mb-4">
        <SourcingBadge status={sourcingStatus || 'Unknown Sourcing'} />
      </div>
      <p>{product.description}</p>
      {/* Additional product details here */}
    </div>
  );
};

export default ProductDetailView;
