// frontend/src/components/product/SourcingBadge.tsx
import React from 'react';

interface SourcingBadgeProps {
  status: SourcingStatus;
}

const SourcingBadge: React.FC<SourcingBadgeProps> = ({ status }) => {
  let badgeColorClass = 'bg-red-500';
  let textColorClass = 'text-white';
  let badgeText = 'Sourcing Unknown';

  switch (status) {
    case 'Ethically Sourced':
      badgeColorClass = 'bg-green-500';
      badgeText = 'Ethically Sourced';
      break;
    case 'Partially Sourced':
      badgeColorClass = 'bg-yellow-500';
      textColorClass = 'text-zinc-900';
      badgeText = 'Partially Sourced';
      break;
    case 'Unknown Sourcing':
      badgeColorClass = 'bg-red-500';
      badgeText = 'Sourcing Unknown';
      break;
  }

  return (
    <span
      className={`inline-block px-2 py-1 text-xs font-semibold leading-none rounded-full ${badgeColorClass} ${textColorClass}`}
    >
      {badgeText}
    </span>
  );
};

export default SourcingBadge;
