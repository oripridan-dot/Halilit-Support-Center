import { ArrowLeft, CheckCircle, Circle, HelpCircle, XCircle } from 'lucide-react';
import { useCallback, useMemo } from 'react';

const ProductDetailView = () => {
    const { activeProductId, goBack, goToInventory } = useNavigationStore();
    const { catalog, products, isLoading: isCatalogLoading } = useConductorCatalog();
    const {
        state: jitState,
        cancelStream,
    } = useJITIntelligence(activeProductId);
    const { accessories, compatible, alternatives, isLoading: isRelationshipsLoading } = useProductRelationships(activeProductId);

    const product = useMemo<Product | undefined>(() => {
        if (!activeProductId || !products) return undefined;
        return products.find(p => p.id === activeProductId);
    }, [activeProductId, products]);

    const displayBrand = product?.brand || jitState.snap?.brand || '';

    const handleBrandClick = useCallback(() => {
        goToInventory(displayBrand);
    }, [displayBrand, goToInventory]);

    const specsRecord = useMemo(() => {
        return jitState.officialSpecs?.specs as Record<string, string> || product?.specs as Record<string, any> || {};
    }, [jitState.officialSpecs?.specs, product?.specs]);

    const formatSpecsAsText = (specs: Record<string, any>): string => {
        return Object.entries(specs)
            .map(([key, value]) => `${key}: ${value}`)
            .join('\n');
    };

    const handleCopySpecs = useCallback(() => {
        const text = formatSpecsAsText(specsRecord);
        navigator.clipboard.writeText(text);
        // TODO: Implement toast
        // showToast('✓ Copied', 1500);
    }, [specsRecord]);

    const handleGenerateQuote = () => {
        window.print();
        // TODO: Implement toast
        // showToast('Quote generated', 1500);
    };

    const handleOpenOfficialPage = useCallback(() => {
        if (product?.official_url) {
            window.open(product.official_url, '_blank', 'noopener,noreferrer');
        }
    }, [product?.official_url]);

    if (!activeProductId || (product === undefined && (jitState.status === "error" || !jitState.snap) && !isCatalogLoading)) {
        return (
            <div className="p-8 max-w-md">
                <p className="text-2xl font-bold text-zinc-400 mb-2">Product Not Found</p>
                <p className="text-sm text-zinc-500 mb-6">
                    No product with ID "{activeProductId}" exists in the catalog.
                </p>
                <button onClick={goBack} className="text-zinc-400 hover:text-white">
                    ← Back to Search
                </button>
            </div>
        );
    }

    const imageUrl = product?.image_url || jitState.snap?.thumbnail || PlaceholderImage;
    const ilPrice = product?.price ?? jitState.snap?.price;
    const eilatPrice = product?.price_eilat ?? jitState.snap?.price_eilat;
    const stock = product?.stock;

    return (
        <div className="bg-zinc-950 min-h-screen">
            <div className="flex items-center p-4">
                <button onClick={goBack} className="text-zinc-400 hover:text-white">
                    <ArrowLeft className="inline mr-2" size={20} /> Back
                </button>
            </div>

            {(isLoading || isCatalogLoading || jitState.phase === 'loading' || jitState.phase === 'idle') && (
                <div className="bg-zinc-900 rounded-xl p-6 flex flex-row gap-6 animate-pulse">
                    <div className="w-48 h-48 rounded-lg bg-zinc-800"></div>
                    <div className="flex-1">
                        <h1 className="text-2xl font-bold text-zinc-800 h-6 w-64 rounded mb-2"></h1>
                        <div className="inline-block px-2 py-0.5 bg-zinc-800/20 text-zinc-400 text-sm rounded cursor-pointer h-4 w-32 rounded mb-1"></div>
                        <p className="font-mono text-zinc-500 text-sm mt-1 h-4 w-24 rounded"></p>
                        <span className="text-xs bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded h-4 w-24 rounded"></span>
                    </div>
                    <div className="w-40 text-right">
                        <p className="text-3xl font-bold text-zinc-800 h-8 w-24 rounded mb-2"></p>
                        <p className="text-sm text-zinc-400">Eilat: ₪...</p>
                    </div>
                </div>
            )}

            {!isLoading && !isCatalogLoading && jitState.phase !== 'loading' && jitState.phase !== 'idle' && product && (
                <div className="bg-zinc-900 rounded-xl p-6 flex flex-row gap-6">
                    <div className="w-48 h-48 rounded-lg bg-white p-2">
                        <img
                            src={imageUrl}
                            alt={product.name}
                            className="object-contain w-full h-full rounded-lg"
                            onError={(e) => {
                                // @ts-ignore
                                e.target.style.opacity = 0.2;
                            }}
                        />
                    </div>
                    <div className="flex-1">
                        <h1 className="text-2xl font-bold text-white">{product.name}</h1>
                        <span
                            className="inline-block px-2 py-0.5 bg-blue-500/20 text-blue-400 text-sm rounded cursor-pointer"
                            onClick={handleBrandClick}
                        >
                            {displayBrand}
                        </span>
                        <p className="font-mono text-zinc-500 text-sm mt-1">{product.id}</p>
                        <span className="text-xs bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded">
                            {product.category} / {product.subcategory}
                        </span>
                    </div>
                    <div className="w-40 text-right">
                        {ilPrice ? (
                            <p className="text-3xl font-bold text-white">₪{ilPrice.toLocaleString()}</p>
                        ) : (
                            <p className="text-amber-400 text-lg">Call for Price</p>
                        )}
                        <p className="text-sm text-zinc-400">Eilat: {eilatPrice ? `₪${eilatPrice}` : '—'}</p>
                        <div className="flex items-center justify-end mt-2">
                            {stock === 0 && (
                                <div className="flex items-center text-red-500 text-xs">
                                    <XCircle size={16} className="mr-1" />
                                    Out of Stock
                                </div>
                            )}
                            {stock && stock > 0 && (
                                <div className="flex items-center text-green-500 text-xs">
                                    <CheckCircle size={16} className="mr-1" />
                                    In Stock
                                </div>
                            )}
                            {stock === null && (
                                <div className="flex items-center text-zinc-400 text-xs">
                                    <Circle size={16} className="mr-1" />
                                    Unknown
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            )}

            <div className="flex flex-row gap-3 py-3 border-y border-zinc-800 sticky top-0 bg-zinc-950 z-10">
                <button
                    className="bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2 rounded-lg text-sm"
                    onClick={handleCopySpecs}
                >
                    📋 Copy Tech Specs
                </button>
                <button
                    className="bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2 rounded-lg text-sm"
                    onClick={handleGenerateQuote}
                >
                    🖨 Generate Quote PDF
                </button>
                <button
                    className={`bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2 rounded-lg text-sm ${!product?.official_url ? 'opacity-50' : ''}`}
                    onClick={handleOpenOfficialPage}
                    disabled={!product?.official_url}
                >
                    🔗 Open Official Page
                </button>
            </div>

            {jitState.error && (
                <div className="bg-amber-900 text-amber-100 p-2 rounded-md mt-2">
                    Intelligence fetch failed: {jitState.error}
                </div>
            )}

            <div className="flex flex-row gap-1 border-b border-zinc-800">
                <button className="border-b-2 border-blue-500 text-white px-4 py-2">Ecosystem</button>
                <button className="text-zinc-500 hover:text-zinc-300 px-4 py-2">Specifications</button>
                <button className="text-zinc-500 hover:text-zinc-300 px-4 py-2">History</button>
            </div>

            <div className="mt-4 min-h-64">
                {/* Ecosystem Tab Content */}
                {/* TODO: Implement Ecosystem Tab Content */}
                <h3 className="text-white text-lg font-semibold mb-2">Verified Accessories</h3>
                {accessories.length === 0 && !isRelationshipsLoading && (
                    <p className="text-zinc-500 text-sm">No verified accessories found in the product graph.</p>
                )}
                {isRelationshipsLoading && (
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {[...Array(3)].map((_, i) => (
                            <div key={i} className="bg-zinc-900 rounded-lg p-3 flex gap-3 animate-pulse">
                                <div className="w-12 h-12 rounded-md bg-zinc-800"></div>
                                <div>
                                    <div className="h-4 w-24 bg-zinc-800 rounded mb-1"></div>
                                    <div className="h-3 w-16 bg-zinc-800 rounded"></div>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
                {accessories.length > 0 && !isRelationshipsLoading && (
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {accessories.map((item) => (
                            <div
                                key={item.id}
                                className="bg-zinc-900 rounded-lg p-3 flex gap-3 cursor-pointer hover:bg-zinc-800"
                                onClick={() => goToInventory(item.brand)}
                            >
                                <img
                                    src={item.image_url || PlaceholderImage}
                                    alt={item.name}
                                    className="w-12 h-12 rounded-md object-contain bg-white"
                                    onError={(e) => {
                                        // @ts-ignore
                                        e.target.style.opacity = 0.2;
                                    }}
                                />
                                <div>
                                    <p className="text-white text-sm">{item.name}</p>
                                    <p className="text-zinc-400 text-xs">{formatPrice(item)}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
                <h3 className="text-white text-lg font-semibold mt-4 mb-2">Alternatives</h3>
                {alternatives.length === 0 && !isRelationshipsLoading && (
                    <p className="text-zinc-500 text-sm">No alternatives found in the product graph.</p>
                )}
                {alternatives.length > 0 && !isRelationshipsLoading && (
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {alternatives.map((item) => (
                            <div
                                key={item.id}
                                className="bg-zinc-900 rounded-lg p-3 flex gap-3 cursor-pointer hover:bg-zinc-800"
                                onClick={() => goToProduct(item.id)}
                            >
                                <img
                                    src={item.image_url || PlaceholderImage}
                                    alt={item.name}
                                    className="w-12 h-12 rounded-md object-contain bg-white"
                                    onError={(e) => {
                                        // @ts-ignore
                                        e.target.style.opacity = 0.2;
                                    }}
                                />
                                <div>
                                    <p className="text-white text-sm">{item.name}</p>
                                    <p className="text-zinc-400 text-xs">{formatPrice(item)}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
                {compatible.length > 0 && (
                    <>
                        <h3 className="text-white text-lg font-semibold mt-4 mb-2">Compatible</h3>
                        {compatible.length > 0 && (
                            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                {compatible.map((item) => (
                                    <div
                                        key={item.id}
                                        className="bg-zinc-900 rounded-lg p-3 flex gap-3 cursor-pointer hover:bg-zinc-800"
                                        onClick={() => goToProduct(item.id)}
                                    >
                                        <img
                                            src={item.image_url || PlaceholderImage}
                                            alt={item.name}
                                            className="w-12 h-12 rounded-md object-contain bg-white"
                                            onError={(e) => {
                                                // @ts-ignore
                                                e.target.style.opacity = 0.2;
                                            }}
                                        />
                                        <div>
                                            <p className="text-white text-sm">{item.name}</p>
                                            <p className="text-zinc-400 text-xs">{formatPrice(item)}</p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}
                    </>
                )}
                {/* Specifications Tab Content */}
                {/* TODO: Implement Specifications Tab Content */}
                {/* TODO: Implement History Tab Content */}
            </div>
            {/* Specifications Tab Content */}
            {/*
                <div className="mt-4">
                    <h3 className="text-white text-lg font-semibold mb-2">Specifications</h3>
                    {Object.keys(specsRecord).length === 0 && (
                        <p className="text-zinc-500 text-sm">Official specifications not yet fetched. Run intelligence on this product.</p>
                    )}
                    {Object.keys(specsRecord).length > 0 && (
                        <table className="w-full text-sm">
                            <tbody>
                                {Object.entries(specsRecord).map(([key, value], index) => (
                                    <tr key={key} className={`even:bg-zinc-900/30`}>
                                        <td className="text-zinc-400 font-medium w-1/3">{key}</td>
                                        <td className="text-white">{value}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    )}
                </div>
                */}
            {/* History Tab Content */}
            {/*
                <div className="mt-4">
                    <p className="text-zinc-500 text-sm">
                        Ticket history coming soon. No records for this product yet.
                    </p>
                </div>
                */}
        </div>
    );
};

export default ProductDetailView;