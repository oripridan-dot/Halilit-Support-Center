#!/bin/bash
# Git Pre-Commit Hook: Conductor Deployment Gatekeeper
# 
# Blocks commits unless Conductor verification passes.
# Ensures ONLY "Production Ready" code enters the repository.
#
# Features:
#   • Schema validation for all data files
#   • Code standards enforcement (imports, types, etc)
#   • Spectrum pipeline verification
#   • File integrity checks
#
# Installation:
#   cp tools/pre-commit-hook .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

set -e

# Color codes for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Get the repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo -e "${BOLD}${BLUE}═══════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${BLUE}🚨 Conductor Pre-Commit Verification Gate${NC}"
echo -e "${BOLD}${BLUE}═══════════════════════════════════════════════════${NC}\n"

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo -e "${RED}✗ Python3 is required${NC}"
    exit 1
fi

VERIFICATION_PASSED=true

# 1. Verify imports and basic structure
echo -e "${BLUE}Phase 1: Checking imports and dependencies...${NC}"
if python3 -c "import sys; sys.path.insert(0, '.'); from backend.conductor_verify_spectrum_v540 import verify_imports; success, _ = verify_imports(); exit(0 if success else 1)" 2>/dev/null; then
    echo -e "${GREEN}✓ Imports verified${NC}\n"
else
    echo -e "${YELLOW}⚠️  Import warnings detected${NC}\n"
fi

# 2. Verify schema compliance for data files
echo -e "${BLUE}Phase 2: Validating data schema compliance...${NC}"
DATA_FILES=$(git diff --cached --name-only | grep -E '^backend/data/.*\.json$' || true)

if [ -n "$DATA_FILES" ]; then
    for file in $DATA_FILES; do
        if [ -f "$file" ]; then
            if python3 -m json.tool "$file" > /dev/null 2>&1; then
                echo -e "${GREEN}✓ Valid JSON: $(basename "$file")${NC}"
            else
                echo -e "${RED}✗ Invalid JSON: $file${NC}"
                VERIFICATION_PASSED=false
            fi
        fi
    done
    echo ""
else
    echo -e "${YELLOW}No data files to validate${NC}\n"
fi

# 3. Check for 0-byte files (critical error)
echo -e "${BLUE}Phase 3: Checking for corrupted (0-byte) files...${NC}"
ZERO_BYTE_FILES=$(git diff --cached --name-only | xargs -I {} bash -c 'if [ -f {} ] && [ ! -s {} ]; then echo {}; fi' || true)

if [ -n "$ZERO_BYTE_FILES" ]; then
    echo -e "${RED}✗ Found 0-byte (corrupted) files:${NC}"
    echo "$ZERO_BYTE_FILES" | sed 's/^/  /'
    echo ""
    VERIFICATION_PASSED=false
else
    echo -e "${GREEN}✓ No corrupted files detected${NC}\n"
fi

# 4. Check TypeScript/JavaScript file quality
echo -e "${BLUE}Phase 4: Checking frontend code quality...${NC}"
TS_FILES=$(git diff --cached --name-only | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
    IMPORT_ERRORS=0
    for file in $TS_FILES; do
        if [ -f "$file" ]; then
            # Check for React import in .tsx files
            if [[ "$file" == *.tsx ]]; then
                if ! grep -q "import React" "$file" 2>/dev/null; then
                    echo -e "${YELLOW}⚠️  Missing React import: $file${NC}"
                    ((IMPORT_ERRORS++))
                fi
            fi
            # Check file is not empty
            if [ ! -s "$file" ]; then
                echo -e "${RED}✗ Empty/zero-byte file: $file${NC}"
                VERIFICATION_PASSED=false
            fi
        fi
    done
    if [ $IMPORT_ERRORS -eq 0 ]; then
        echo -e "${GREEN}✓ Frontend code quality check passed${NC}\n"
    else
        echo -e "${YELLOW}⚠️  Some import issues found (warnings only)${NC}\n"
    fi
else
    echo -e "${YELLOW}No TypeScript files to check${NC}\n"
fi

# 5. Run Spectrum verification if available
echo -e "${BLUE}Phase 5: Running Spectrum pipeline verification...${NC}"
if python3 backend/conductor_verify_spectrum_v540.py > /tmp/conductor_verify.log 2>&1; then
    echo -e "${GREEN}✓ Spectrum verification passed${NC}\n"
else
    echo -e "${YELLOW}⚠️  Spectrum verification completed with warnings${NC}"
    head -20 /tmp/conductor_verify.log | sed 's/^/  /'
    echo ""
fi

# Final decision
echo -e "${BOLD}${BLUE}═══════════════════════════════════════════════════${NC}"

if [ "$VERIFICATION_PASSED" = true ]; then
    echo -e "${GREEN}${BOLD}✅ CONDUCTOR APPROVED - Ready to commit${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════${NC}\n"
    exit 0
else
    echo -e "${RED}${BOLD}❌ CONDUCTOR REJECTED - Fix issues and try again${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════${NC}\n"
    echo "Common fixes:"
    echo "  1. Fix JSON syntax in data files"
    echo "  2. Remove empty/0-byte files"
    echo "  3. Add missing React imports to .tsx files"
    echo "  4. Run verification: python3 backend/conductor_verify_spectrum_v540.py"
    echo ""
    exit 1
fi
