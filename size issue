# 7 · FRONTEND COMPONENT INVENTORY
# ═══════════════════════════════════════════════════════════════════════════════


class TestFrontendComponents:
    """Frontend Components must be well-formed and meet size constraints."""

    def test_no_monolithic_components(self):
        """No component exceeds maximum line count."""
        max_lines = 100  # Define a reasonable max line count.  Adjust as needed.
        too_large = []
        # Find all .tsx files in the frontend/src/components directory.
        component_files = list(
            (ROOT / "frontend" / "src" / "components").rglob("*.tsx")
        )

        for file_path in component_files:
            with open(file_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
                if len(lines) > max_lines:
                    too_large.append(
                        f"{file_path.relative_to(ROOT)} ({len(lines)} lines)"
                    )

        assert (
            len(too_large) == 0
        ), f"The following components exceed the maximum line count of {max_lines}:\n{chr(10).join(too_large)}"


