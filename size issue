# 6 · NEXUS CLI — Argument Parsing & Steering Gate
# ═══════════════════════════════════════════════════════════════════════════════


class TestNexusCLI:
    """Nexus CLI must correctly parse arguments and steer the system."""

    def test_review_changes_no_diff_passes_silently(self, mocker):
        """'review-changes' with no diff passes silently (returns True)."""
        cli = NexusCLI()
        mocker.patch.object(cli, "get_git_diff", return_value="")
        mocker.patch.object(cli, "commit_changes")
        result = cli.review_changes(auto_mode=False)  # Ensure auto_mode is off
        assert result is True

    def test_review_changes_auto_mode_commits(self, mocker):
        """'review-changes --auto' mode commits changes (returns True)."""
        cli = NexusCLI()
        mocker.patch.object(cli, "get_git_diff", return_value="some diff")
        mocker.patch.object(cli, "commit_changes", return_value=True)
        result = cli.review_changes(auto_mode=True)
        assert result is True

    def test_review_changes_reject_reverts(self, mocker):
        """'review-changes' with rejection reverts changes (returns False)."""
        cli = NexusCLI()
        mocker.patch.object(cli, "get_git_diff", return_value="some diff")
        mocker.patch.object(cli, "commit_changes", return_value=False)
        result = cli.review_changes(auto_mode=False)  # Ensure auto_mode is off
        assert result is False

    def test_review_changes_y_commits(self, mocker):
        """'review-changes -y' mode commits changes (returns True)."""
        cli = NexusCLI()
        mocker.patch.object(cli, "get_git_diff", return_value="some diff")
        mocker.patch.object(cli, "commit_changes", return_value=True)
        result = cli.review_changes(auto_mode=True)
        assert result is True

    def test_nexus_cli_processes_valid_command(self, mocker):
        """NexusCLI processes a valid command without errors."""
        cli = NexusCLI()
        mocker.patch.object(cli, "review_changes", return_value=True)
        try:
            cli.execute(["review-changes"])
        except Exception as e:
            pytest.fail(f"NexusCLI failed to process valid command: {e}")

    def test_nexus_cli_handles_invalid_command(self):
        """NexusCLI handles an invalid command gracefully."""
        cli = NexusCLI()
        with pytest.raises(SystemExit):  # Expecting the CLI to exit on error.
            cli.execute(["invalid-command"])

    def test_nexus_cli_handles_missing_command(self):
        """NexusCLI handles a missing command gracefully."""
        cli = NexusCLI()
        with pytest.raises(SystemExit):  # Expecting the CLI to exit on error.
            cli.execute([])


