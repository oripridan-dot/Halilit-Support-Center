class TestFactoryAgents:
    """Factory Agents must adhere to import hygiene and contract."""

    @pytest.fixture(autouse=True)
    def _import(self):
        from backend.factory.agent_interface import AgentInterface
        from backend.factory.agent_registry import AgentRegistry

        self.AgentInterface = AgentInterface
        self.AgentRegistry = AgentRegistry

    def test_agent_interface_is_abstract(self):
        """AgentInterface is abstract (cannot be directly instantiated)."""
        with pytest.raises(TypeError):
            self.AgentInterface()

    def test_agent_registry_can_load_agents(self):
        """AgentRegistry can load agents."""
        registry = self.AgentRegistry()
        # Assuming there are agents in the factory directory.
        try:
            registry.load_agents()
            assert len(registry.agents) > 0
        except Exception as e:
            pytest.fail(f"AgentRegistry failed to load agents: {e}")

    def test_agents_implement_interface(self):
        """All loaded agents implement the AgentInterface."""
        registry = self.AgentRegistry()
        registry.load_agents()
        for agent_name, agent_class in registry.agents.items():
            try:
                # Attempt to instantiate and check for interface methods.
                agent_instance = agent_class()
                assert hasattr(agent_instance, "execute"), (
                    f"Agent {agent_name} missing execute method"
                )
            except Exception as e:
                pytest.fail(
                    f"Agent {agent_name} does not implement AgentInterface: {e}"
                )


