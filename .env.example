# Halilit Support Center v9.0 — JIT Architecture
# Copy this to .env and fill in your actual API keys

# ============================================================================
# API KEYS (Required for JIT intelligence)
# ============================================================================

# Google Gemini API — Powers the JIT Agent (Gemini 2.0 Flash)
# Get from https://makersuite.google.com/app/apikey (Google AI Studio)
GOOGLE_API_KEY=your_google_ai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Web Search API — Used by JIT agent for trusted review lookups
# Get from https://serpapi.com (100 free searches/month)
SERP_API_KEY=your_serpapi_key_here

# ============================================================================
# SCRAPER CONFIGURATION (Skeleton Sync)
# ============================================================================

# Run browser in headless mode (no visual window)
SCRAPER_HEADLESS=true

# Page load timeout in milliseconds
SCRAPER_TIMEOUT_MS=30000

# Number of retries for failed scrapes
SCRAPER_RETRIES=3

# Number of concurrent browser instances
SCRAPER_CONCURRENT=3

# ============================================================================
# JIT AGENT CONFIGURATION
# ============================================================================

# Cache TTL in seconds (default: 7 days = 604800)
JIT_CACHE_TTL=604800

# Gemini model to use
JIT_GEMINI_MODEL=gemini-2.0-flash

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# PRODUCTION (optional)
# ============================================================================

# Restrict CORS to your frontend origin(s). Comma-separated. Default: * (allow all)
# CORS_ORIGINS=https://localhost:5173,https://app.example.com

# Override project root for paths (default: auto-detected from backend location)
# HALILIT_PROJECT_ROOT=/path/to/Halilit-Support-Center

# ============================================================================
# OPTIONAL: HALILIT WEBSITE CREDENTIALS
# ============================================================================

# If Halilit website requires authentication
HALILIT_USERNAME=
HALILIT_PASSWORD=

# ============================================================================
# WORKTREES / MULTIPLE INSTANCES (Optional)
# ============================================================================
# Use when running a second Git worktree (e.g. feature branch) so both don't
# bind the same ports. Set in the *alternate* worktree's .env only.
#
# COMPOSE_PROJECT_NAME=halilit-feature
# PORT_BACKEND=8001
# PORT_FRONTEND=5174
#
# If you run the API via Docker (api_server uncommented in docker-compose.yml),
# PORT_BACKEND is applied there. For Vite, run: npm run dev -- --port ${PORT_FRONTEND:-5173}

# ============================================================================
# NOTES
# ============================================================================

# The JIT architecture does NOT require upfront ingestion.
# To get started:
#   1. Set GOOGLE_API_KEY (for Gemini JIT intelligence)
#   2. Run skeleton sync: PYTHONPATH=. python3 backend/skeleton_sync.py
#   3. Start the app: ./start.sh
#
# Product data is fetched on-demand when users view a product.
# Skeleton sync only collects: ID, Name, Price, URL, Thumbnail (~30 seconds).
