# Halilit Support Center - Environment Configuration
# Copy this to .env and fill in your actual API keys

# ============================================================================
# API KEYS (Required for real data ingestion)
# ============================================================================

# Web Search API - Get from https://serpapi.com (100 free searches/month)
SERP_API_KEY=your_serpapi_key_here

# OpenAI API - Get from https://platform.openai.com
# Use gpt-3.5-turbo for cost-effective AI synthesis
OPENAI_API_KEY=your_openai_key_here

# Google Gemini API - Alternative to OpenAI (optional)
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ============================================================================
# SCRAPER CONFIGURATION
# ============================================================================

# Run browser in headless mode (no visual window)
SCRAPER_HEADLESS=true

# Page load timeout in milliseconds
SCRAPER_TIMEOUT_MS=30000

# Number of retries for failed scrapes
SCRAPER_RETRIES=3

# Number of concurrent browser instances
SCRAPER_CONCURRENT=3

# ============================================================================
# PIPELINE CONFIGURATION
# ============================================================================

# Automatically generate TypeScript types
GENERATE_TYPES=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: HALILIT WEBSITE CREDENTIALS
# ============================================================================

# If Halilit website requires authentication
HALILIT_USERNAME=
HALILIT_PASSWORD=

# ============================================================================
# NOTES
# ============================================================================

# Mock data is automatically used if API keys are not configured.
# This is useful for testing the pipeline structure.
#
# To run with REAL data:
# 1. Set SERP_API_KEY (web search)
# 2. Set OPENAI_API_KEY or GEMINI_API_KEY (AI synthesis)
# 3. Configure brand URLs in backend/ingestion/manifest.json
# 4. Run: PYTHONPATH=. python -m backend.pipeline run
#
# For development/testing without real data:
# Leave API keys empty - mock data will be used automatically
