# 🔌 TooLoo Configuration for Halilit Support Center
# This file configures how TooLoo (the autonomous AI engine) operates on this repository

# Repository Identity
PROJECT_NAME="Halilit Support Center"
PROJECT_SLUG="halilit-support-center"
PROJECT_DESCRIPTION="AI-powered intelligent support ticketing and knowledge base system"

# TooLoo Core Path
# Points to the external TooLoo engine (repository-agnostic orchestrator)
TOOLOO_PATH="../tooloo-core"

# Repository Structure
# Tell TooLoo where important directories are
FRONTEND_DIR="frontend"
BACKEND_DIR="backend"
SPECS_DIR="specs"
DOCS_DIR="docs"
TESTS_DIR="backend/tests"

# Deployment Configuration
DOCKER_ENABLED="true"
DOCKER_COMPOSE_FILE="docker-compose.yml"

# Version Management
CURRENT_VERSION=$(cat .version)
CHANGELOG_PATH="CHANGELOG.md"

# CI/CD Settings
GITHUB_WORKFLOWS_DIR=".github/workflows"
GITHUB_REPO="oripridan-dot/Halilit-Support-Center"

# Warden sentry configuration
HEALTH_CHECK_URL="http://localhost:3000/api/health"
TOOLOO_CORE_URL="http://localhost:8000"
WARDEN_ENABLED="true"

# Development Environment
DEV_CONTAINER_ENABLED="true"
DEV_CONTAINER_CONFIG=".devcontainer/devcontainer.json"

# Default Agents
# These are the agents that TooLoo will activate for this project
CHIEF_AGENT_ENABLED="true"
TECH_LEAD_AGENT_ENABLED="true"
REPO_AGENT_ENABLED="true"
BUILDER_AGENT_ENABLED="true"
WATCHDOG_AGENT_ENABLED="true"

# Verification Targets
FRONTEND_BUILD_COMMAND="cd frontend && npm run build"
BACKEND_TESTS_COMMAND="pytest backend/tests"
LINT_COMMAND="cd frontend && npm run lint"

# Features
AUTO_CHANGELOG="true"
AUTO_VERSION_BUMP="true"
SEMANTIC_COMMITS="true"
