{
  "config_meta": {
    "version": "1.0",
    "last_updated": "2026-01-30",
    "description": "Master logic for product sorting and validation thresholds."
  },
  "global_validation_settings": {
    "price_variance_tolerance": 0.15,
    "min_trusted_reviews": 2,
    "confidence_threshold_for_diamond": 80,
    "stock_status_priority": "COMMERCIAL"
  },
  "scoring_weights": {
    "base_official_data": 30,
    "has_price": 10,
    "has_manual": 5,
    "per_trusted_review": 20,
    "verified_pro_feature": 10,
    "recurring_issue_penalty": -30,
    "unverified_penalty": -15
  },
  "taxonomy_definitions": [
    {
      "id": "STUDIO_MONITORS",
      "display_name": "Studio Monitors",
      "folder_name": "monitors",
      "sub_divisions": [
        {
          "id": "NEARFIELD",
          "display_name": "Nearfield Monitors",
          "rules": {
            "required_keywords": ["monitor", "active", "2-way"],
            "excluded_keywords": ["subwoofer", "passive", "headphone"],
            "spec_triggers": {
              "woofer_size_inch": { "min": 3.0, "max": 8.0 },
              "frequency_response_low_hz": { "max": 60 }
            }
          }
        },
        {
          "id": "MID_MAIN",
          "display_name": "Midfield & Main",
          "rules": {
            "required_keywords": ["monitor", "3-way", "farfield"],
            "excluded_keywords": ["portable"],
            "spec_triggers": {
              "woofer_size_inch": { "min": 8.1, "max": 15.0 },
              "power_total_watts": { "min": 200 }
            }
          }
        },
        {
          "id": "SUBWOOFERS",
          "display_name": "Studio Subwoofers",
          "rules": {
            "required_keywords": ["subwoofer", "lfe"],
            "excluded_keywords": ["top", "satellite"],
            "spec_triggers": {
              "frequency_response_low_hz": { "max": 40 }
            }
          }
        }
      ]
    },
    {
      "id": "AUDIO_INTERFACES",
      "display_name": "Audio Interfaces",
      "folder_name": "interfaces",
      "sub_divisions": [
        {
          "id": "DESKTOP_USB",
          "display_name": "Desktop / USB",
          "rules": {
            "required_keywords": ["usb", "interface"],
            "excluded_keywords": ["pci", "thunderbolt", "rack"],
            "spec_triggers": {
              "analog_inputs": { "max": 4 }
            }
          }
        },
        {
          "id": "RACK_STUDIO",
          "display_name": "Rackmount / Pro",
          "rules": {
            "required_keywords": ["rack", "1u", "thunderbolt", "dante"],
            "excluded_keywords": ["mobile"],
            "spec_triggers": {
              "analog_inputs": { "min": 8 }
            }
          }
        }
      ]
    },
    {
      "id": "MICROPHONES",
      "display_name": "Microphones",
      "folder_name": "microphones",
      "sub_divisions": [
        {
          "id": "CONDENSER",
          "display_name": "Condenser Mics",
          "rules": {
            "required_keywords": ["condenser", "wa-87"],
            "spec_triggers": {}
          }
        }
      ]
    },
    {
      "id": "ACCESSORIES",
      "display_name": "Studio Accessories",
      "folder_name": "accessories",
      "sub_divisions": [
        {
          "id": "STANDS",
          "display_name": "Stands & Hardware",
          "rules": {
            "required_keywords": ["stand", "bespeco", "arm"],
            "spec_triggers": {}
          }
        },
        {
          "id": "TUNING",
          "display_name": "Tuning & Dampening",
          "rules": {
            "required_keywords": ["tuner", "drumdots", "fzone"],
            "spec_triggers": {}
          }
        }
      ]
    }
  ]
}
